{
  "name": "crazywaterword",
  "version": "1.0.0",
  "description": "微信小游戏《疯狂水世界》协议侧挂机工具：直连游戏网关完成日常/任务/英雄/海面循环，附本地网页控制台",
  "type": "module",
  "main": "src/app.mjs",
  "scripts": {
    "build:ui": "esbuild src/ui/console.tsx --bundle --platform=node --format=esm --packages=external --outfile=src/ui/dist/console.mjs && tailwindcss -i src/ui/theme.css -o src/ui/dist/theme.css --minify",
    "start": "node src/app.mjs",
    "test": "node src/selftest.mjs && node tools/selftest-automation.mjs && node tools/selftest-hero-show-rewards.mjs && node tools/selftest-daily-schedule.mjs && node tools/selftest-ad-shop.mjs && npm run test:level16",
    "test:level16": "node tools/selftest-trial-sweeps.mjs && node tools/selftest-hero-equipment.mjs && node tools/selftest-guild.mjs && node tools/selftest-fleet-formation.mjs && node tools/selftest-pirate-hunt.mjs",
    "test:capture": "node tools/selftest-raw-capture.mjs && node tools/selftest-douyin-cli.mjs",
    "test:wxapkg": "node tools/selftest-wxapkg.mjs",
    "test:wechat": "node tools/selftest-wechat-capture.mjs && node tools/selftest-wechat-cli.mjs",
    "capture": "node tools/capture-credentials.mjs",
    "capture:douyin": "node tools/capture-douyin-login.mjs",
    "sync-config": "node tools/sync-config.mjs",
    "sync-art": "node tools/sync-art.mjs"
  },
  "keywords": [
    "wechat",
    "minigame",
    "protocol",
    "protobuf",
    "websocket"
  ],
  "license": "ISC",
  "private": false,
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "protobufjs": "^7.6.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
